# Configuración de base de datos PostgreSQL (ej. Supabase con connection pooling)
# Reemplaza los valores con tus credenciales locales o URL de Railway/Supabase/etc
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/remanga_db?schema=public"

# Conexión directa a PostgreSQL (requerida por Prisma Migrate / Supabase direct URL)
DIRECT_URL="postgresql://usuario:contraseña@localhost:5432/remanga_db?schema=public"

# Puerto en el que se ejecuta el servidor backend
PORT=4000

# URL del frontend para configuración de CORS
FRONTEND_URL=http://localhost:3000

# Clave secreta para la firma y verificación criptográfica de JWT (mínimo 32 caracteres seguros)
JWT_SECRET="tu-clave-secreta-jwt-super-segura-y-aleatoria-de-produccion"

# Tiempo de expiración de los tokens JWT (ej. 24h, 7d, 3600s)
JWT_EXPIRES_IN="24h"
